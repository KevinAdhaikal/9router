{
  "name": "9router-app",
  "version": "0.5.116",
  "description": "9Router AI Routing Gateway for Cloudflare Workers",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist --config wrangler.pages.jsonc",
    "build": "vite build",
    "build:client": "vite build",
    "build:worker": "vite build && wrangler deploy --dry-run",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:worker": "vite build && wrangler deploy",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --config wrangler.pages.jsonc --no-bundle"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "confbox": "^0.2.4",
    "cookie": "0.7.2",
    "hono": "^4.13.19",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "next": "^16.4.5",
    "node-forge": "^1.3.3",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "undici": "^7.30.2",
    "uuid": "^13.0.0",
    "vite": "^8.3.8",
    "wouter": "^3.13.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "ajv": "^8.17.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "cookie": "0.7.2",
    "dompurify": "^3.4.17",
    "ip-address": "^10.7.4"
  }
}
